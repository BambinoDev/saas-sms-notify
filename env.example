APP_NAME="CommCare SMS Automation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Abidjan
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

DB_CONNECTION=pgsql
DB_HOST=notify_sms_postgres
DB_PORT=5432
DB_DATABASE=notify_sms_db
DB_USERNAME=laravel
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=notify_sms_redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=database

MAIL_MAILER=smtp
MAIL_HOST=notify_sms_mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@notify-sms.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# CommCare API Configuration
COMMCARE_BASE_URL=https://www.commcarehq.org
COMMCARE_API_KEY=
COMMCARE_PROJECT_SPACE=
COMMCARE_USERNAME=
COMMCARE_PASSWORD=

# SMS Service Configuration - Africa's Talking (Sandbox)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=atsk_ffadb6fd2948b71783cdda2e660f165417255b3d8c99d0d8d18267e88e83c94b5bb974f2
AFRICAS_TALKING_SENDER_ID=S-REMIND
AFRICAS_TALKING_ENVIRONMENT=sandbox

# Application Settings
DEFAULT_SMS_RULE_DAYS_BEFORE=2
DEFAULT_SMS_RULE_DAYS_AFTER=2
DEFAULT_SMS_RULE_CATCHUP_WINDOW=7
DEFAULT_TIMEZONE=Africa/Abidjan

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Broadcasting
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
